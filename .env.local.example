# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — it stays on your machine only.

# Your GitHub Personal Access Token (needs Contents: Read & Write on the private repo)
VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# Your private repo in owner/repo format
VITE_GITHUB_REPO=debjyoti-samanta-ind/mycelium-private
